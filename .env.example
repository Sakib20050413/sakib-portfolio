# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.vercel.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com,https://*.vercel.app

# Secret Admin Slug (e.g., studio-7f3k/ ensures /admin/ returns 404)
ADMIN_URL=studio-7f3k/

# Database (Leave empty for local db.sqlite3, or provide Neon/Supabase PostgreSQL connection string)
DATABASE_URL=

# Cloudinary Media Storage (Optional locally; required for persistent uploads in production)
CLOUDINARY_URL=
